# Unpacked — environment variables
#
# Copy to .env.local and fill in. NEVER commit .env.local — .gitignore blocks
# every .env* file except this example.
#
# Production values live in Vercel → Project Settings → Environment Variables.
# Anything NEXT_PUBLIC_* is exposed to the browser: never put a secret there.

# ── Required: the article pipeline will not run without these ────────────────

# Anthropic — Haiku planning, Sonnet editorial/premium writing.
# If this account runs out of credit, lib/anthropic-client.ts replays the call
# on Gemini, so the site degrades instead of stopping.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini — blueprint, default writer, fact-check grounding, social copy.
GOOGLE_GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Brave Search — web research and image search. Paid plan.
BRAVE_SEARCH_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase — database, auth, image storage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx
# Server-side ONLY. Bypasses row-level security — never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# ── Recommended: features degrade quietly without them ───────────────────────

# OpenAI — third voice in fact-check arbitration only. Without it, arbitration
# is skipped; stages 1 and 2 still run.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Stock image fallbacks. Google Images is the primary source, so these only
# matter when it returns nothing usable.
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
UNSPLASH_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# SerpAPI — Google Trends live data. Without it, trend charts are omitted.
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Admin identity. The first two are public (used by the useAdminMode hook);
# the second two are server-side (lib/auth-check.ts). All four hold the same
# two values — consolidating them is PLAN.md M3.
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com
NEXT_PUBLIC_ADMIN_USER_ID=00000000-0000-0000-0000-000000000000
ADMIN_EMAIL=you@example.com
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# ── Production-only: safe to leave unset in local development ────────────────

# Vercel Cron auth for /api/cron/daily-article. Any long random string
# (openssl rand -hex 32). CRITICAL: Vercel only sends the Authorization header
# when this variable EXISTS on the project — if it is missing, every scheduled
# run is rejected with 401 and no daily article is ever produced.
CRON_SECRET=

# Stripe billing. Checkout returns an error if the secret key is absent.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STANDARD=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxx

# PostHog analytics. Unset = analytics silently disabled.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Optional tuning: all have working defaults ───────────────────────────────

# Concurrent Gemini generations. Default 3. In-memory, so it is per serverless
# instance and does not coordinate across them.
GEMINI_MAX_CONCURRENT=3

# 'unlisted' turns the daily auto-article into a review queue (live URL, off
# the homepage). Default: published.
DAILY_ARTICLE_VISIBILITY=

# Monthly ceiling in dollars for auto-articles. Default 5.
DAILY_ARTICLE_MONTHLY_BUDGET=5

# 'off' disables Reddit native comment fetching, falling back to Brave
# snippets. Default: on.
REDDIT_NATIVE_API=

# Reserved. lib/research-orchestrator.ts documents a TwitterAPI.io swap but
# NOTHING READS THIS YET — X research goes through Brave site:x.com searches.
TWITTER_API_KEY=
